# Only needed to run Job Hunter on your own computer. On GitHub these go in
# Settings -> Secrets and variables -> Actions instead. Copy to ".env".

# Same Gmail account and app password as House Hunter.
SMTP_USER=yourname.househunter@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
EMAIL_TO=you@example.com

# Optional extras
ANTHROPIC_API_KEY=
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
